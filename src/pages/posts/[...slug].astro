---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { formatDate } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
---
<Base title={title} description={description} type="article">
  <article>
    <h1>{title}</h1>
    <div class="post-meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {updated && <span>更新於 {formatDate(updated)}</span>}
      {tags.length > 0 && (
        <span class="tags">
          {tags.map((t) => <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}
        </span>
      )}
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="post-nav" aria-label="上一篇與下一篇">
    <div>{older && <a href={`/posts/${older.id}/`}><small>← 較舊</small>{older.data.title}</a>}</div>
    <div class="next">{newer && <a href={`/posts/${newer.id}/`}><small>較新 →</small>{newer.data.title}</a>}</div>
  </nav>
</Base>
